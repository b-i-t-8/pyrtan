 "trees": {
  "github-release": {
   "description": "The latest release of a GitHub repository.",
   "hosts": [
    "api.github.com"
   ],
   "inputs": {
    "repo": {
     "description": "owner/name",
     "pattern": "^[A-Za-z0-9_.\\-]+/[A-Za-z0-9_.\\-]+$",
     "type": "str"
    }
   },
   "license": "MIT",
   "name": "github-release",
   "nodes": {
    "fetch": {
     "extract": [
      {
       "into": "tag",
       "json": "json.tag_name"
      },
      {
       "into": "name",
       "json": "json.name"
      },
      {
       "into": "published",
       "json": "json.published_at"
      },
      {
       "into": "url",
       "json": "json.html_url"
      },
      {
       "into": "prerelease",
       "json": "json.prerelease"
      }
     ],
     "http": {
      "headers": {
       "Accept": "application/vnd.github+json"
      },
      "method": "GET",
      "url": "https://api.github.com/repos/{{ inputs.repo }}/releases/latest"
     },
     "into": "resp",
     "kind": "observe",
     "next": "status"
    },
    "none": {
     "kind": "fail",
     "reason": "no-release",
     "say": "{{ inputs.repo }} has no releases, or does not exist."
    },
    "rate-limited": {
     "kind": "fail",
     "reason": "rate-limited",
     "say": "GitHub is rate-limiting unauthenticated requests ({{ state.resp.status }})."
    },
    "reply": {
     "kind": "done",
     "output": {
      "name": "{{ state.name }}",
      "prerelease": "{{ state.prerelease }}",
      "published": "{{ state.published }}",
      "repo": "{{ inputs.repo }}",
      "tag": "{{ state.tag }}",
      "url": "{{ state.url }}"
     },
     "say": "{{ inputs.repo }}: {{ state.tag }} ({{ state.published }}) {{ state.url }}"
    },
    "status": {
     "branches": [
      {
       "then": "reply",
       "when": {
        "eq": 200
       }
      },
      {
       "then": "none",
       "when": {
        "eq": 404
       }
      },
      {
       "then": "rate-limited",
       "when": {
        "in": [
         403,
         429
        ]
       }
      },
      {
       "else": "unexpected"
      }
     ],
     "kind": "decide",
     "on": "resp.status"
    },
    "unexpected": {
     "kind": "fail",
     "reason": "unexpected-response",
     "say": "GitHub answered {{ state.resp.status }}."
    }
   },
   "start": "fetch",
   "tags": [
    "github",
    "read-only"
   ],
   "triggers": [
    {
     "pattern": "[what's the] latest release of {repo:word}"
    },
    {
     "pattern": "latest {repo:word} release"
    }
   ],
   "version": 1
  },
  "hacker-news": {
   "description": "Top stories on Hacker News, from its public API.",
   "hosts": [
    "hacker-news.firebaseio.com"
   ],
   "inputs": {
    "count": {
     "default": 1,
     "description": "How many stories to return",
     "max": 30,
     "min": 1,
     "type": "int"
    }
   },
   "license": "MIT",
   "name": "hacker-news",
   "nodes": {
    "any": {
     "branches": [
      {
       "then": "nothing",
       "when": {
        "empty": true
       }
      },
      {
       "then": "stories",
       "when": {
        "type": "list"
       }
      },
      {
       "else": "unexpected"
      }
     ],
     "kind": "decide",
     "on": "ids"
    },
    "check": {
     "branches": [
      {
       "then": "any",
       "when": {
        "eq": 200
       }
      },
      {
       "then": "hn-down",
       "when": {
        "gte": 500
       }
      },
      {
       "else": "unexpected"
      }
     ],
     "kind": "decide",
     "on": "ids_resp.status"
    },
    "fetch-ids": {
     "extract": [
      {
       "into": "ids",
       "json": "json"
      }
     ],
     "http": {
      "method": "GET",
      "url": "https://hacker-news.firebaseio.com/v0/topstories.json"
     },
     "into": "ids_resp",
     "kind": "observe",
     "next": "check"
    },
    "hn-down": {
     "kind": "fail",
     "reason": "upstream-down",
     "say": "Hacker News answered {{ state.ids_resp.status }}; try again later."
    },
    "nothing": {
     "kind": "fail",
     "reason": "no-stories",
     "say": "Hacker News returned an empty front page."
    },
    "reply": {
     "kind": "done",
     "output": {
      "stories": "{{ state.stories }}"
     },
     "say": "Top of Hacker News: {{ state.stories[0].title }} — {{ state.stories[0].url }}"
    },
    "stories": {
     "into": "stories",
     "kind": "each",
     "limit": "{{ inputs.count }}",
     "next": "reply",
     "over": "ids",
     "tree": "hacker-news-item",
     "with": {
      "id": "{{ item }}"
     }
    },
    "unexpected": {
     "kind": "fail",
     "reason": "unexpected-response",
     "say": "Hacker News answered {{ state.ids_resp.status }} with something this tree does not recognise."
    }
   },
   "start": "fetch-ids",
   "tags": [
    "news",
    "read-only"
   ],
   "triggers": [
    {
     "inputs": {
      "count": 1
     },
     "pattern": "[what's the] top story on hacker news"
    },
    {
     "pattern": "top {count:int} stories on hacker news"
    }
   ],
   "version": 1
  },
  "hacker-news-item": {
   "description": "One Hacker News item by id: title, url, score, author.",
   "hosts": [
    "hacker-news.firebaseio.com"
   ],
   "inputs": {
    "id": {
     "description": "The item id",
     "min": 1,
     "type": "int"
    }
   },
   "license": "MIT",
   "name": "hacker-news-item",
   "nodes": {
    "fetch": {
     "extract": [
      {
       "into": "title",
       "json": "json.title"
      },
      {
       "into": "url",
       "json": "json.url"
      },
      {
       "into": "score",
       "json": "json.score"
      },
      {
       "into": "by",
       "json": "json.by"
      },
      {
       "into": "type",
       "json": "json.type"
      }
     ],
     "http": {
      "method": "GET",
      "url": "https://hacker-news.firebaseio.com/v0/item/{{ inputs.id }}.json"
     },
     "into": "resp",
     "kind": "observe",
     "next": "kind"
    },
    "has-url": {
     "branches": [
      {
       "then": "reply",
       "when": {
        "exists": true
       }
      },
      {
       "else": "self-post"
      }
     ],
     "kind": "decide",
     "on": "url"
    },
    "kind": {
     "branches": [
      {
       "then": "has-url",
       "when": {
        "eq": "story"
       }
      },
      {
       "then": "has-url",
       "when": {
        "eq": "job"
       }
      },
      {
       "then": "missing",
       "when": {
        "exists": false
       }
      },
      {
       "else": "not-a-story"
      }
     ],
     "kind": "decide",
     "on": "type"
    },
    "missing": {
     "kind": "fail",
     "reason": "no-such-item",
     "say": "There is no Hacker News item {{ inputs.id }}."
    },
    "not-a-story": {
     "kind": "fail",
     "reason": "not-a-story",
     "say": "Item {{ inputs.id }} is a {{ state.type }}, not a story."
    },
    "reply": {
     "kind": "done",
     "output": {
      "by": "{{ state.by }}",
      "id": "{{ inputs.id }}",
      "score": "{{ state.score }}",
      "title": "{{ state.title }}",
      "url": "{{ state.url }}"
     },
     "say": "{{ state.title }} ({{ state.score }} points, by {{ state.by }}) {{ state.url }}"
    },
    "self-post": {
     "kind": "set",
     "next": "reply",
     "set": {
      "url": "https://news.ycombinator.com/item?id={{ inputs.id }}"
     }
    }
   },
   "start": "fetch",
   "tags": [
    "news",
    "read-only"
   ],
   "triggers": [
    {
     "pattern": "hacker news item {id:int}"
    }
   ],
   "version": 1
  },
  "site-status": {
   "description": "Whether a web site answers, and how quickly.",
   "hosts": [
    "*"
   ],
   "inputs": {
    "host": {
     "description": "A host name, with no scheme",
     "pattern": "(?i)^[a-z0-9.\\-]+(:[0-9]+)?$",
     "type": "str"
    }
   },
   "license": "MIT",
   "name": "site-status",
   "nodes": {
    "erroring": {
     "kind": "fail",
     "output": {
      "host": "{{ inputs.host }}",
      "status": "{{ state.resp.status }}",
      "up": false
     },
     "reason": "server-error",
     "say": "{{ inputs.host }} is answering {{ state.resp.status }}: up, but broken."
    },
    "odd": {
     "kind": "fail",
     "reason": "unexpected-status",
     "say": "{{ inputs.host }} answered {{ state.resp.status }}, which this tree has no branch for."
    },
    "probe": {
     "http": {
      "method": "GET",
      "url": "https://{{ inputs.host | lower }}/"
     },
     "into": "resp",
     "kind": "observe",
     "next": "status",
     "retries": 1,
     "timeout": 8
    },
    "refusing": {
     "kind": "done",
     "output": {
      "host": "{{ inputs.host }}",
      "note": "client error on /",
      "status": "{{ state.resp.status }}",
      "up": true
     },
     "say": "{{ inputs.host }} answers but refuses the front page ({{ state.resp.status }}); the server is up."
    },
    "status": {
     "branches": [
      {
       "then": "up",
       "when": {
        "between": [
         200,
         399
        ]
       }
      },
      {
       "then": "refusing",
       "when": {
        "between": [
         400,
         499
        ]
       }
      },
      {
       "then": "erroring",
       "when": {
        "gte": 500
       }
      },
      {
       "else": "odd"
      }
     ],
     "kind": "decide",
     "on": "resp.status"
    },
    "up": {
     "kind": "done",
     "output": {
      "elapsed_ms": "{{ state.resp.elapsed_ms }}",
      "host": "{{ inputs.host }}",
      "status": "{{ state.resp.status }}",
      "up": true
     },
     "say": "{{ inputs.host }} is up: {{ state.resp.status }} in {{ state.resp.elapsed_ms }} ms."
    }
   },
   "start": "probe",
   "tags": [
    "ops",
    "read-only"
   ],
   "triggers": [
    {
     "pattern": "is {host:host} up"
    },
    {
     "pattern": "is {host:host} down"
    },
    {
     "pattern": "[check] status of {host:host}"
    }
   ],
   "version": 1
  },
  "weather": {
   "description": "Current weather for a place, from Open-Meteo.",
   "hosts": [
    "geocoding-api.open-meteo.com",
    "api.open-meteo.com"
   ],
   "inputs": {
    "place": {
     "description": "A town or city name",
     "type": "str"
    },
    "units": {
     "default": "celsius",
     "one_of": [
      "celsius",
      "fahrenheit"
     ],
     "type": "str"
    }
   },
   "language": {
    "synonyms": {
     "weather": [
      "forecast",
      "temperature"
     ]
    }
   },
   "license": "MIT",
   "name": "weather",
   "nodes": {
    "clear": {
     "kind": "set",
     "next": "reply",
     "set": {
      "sky": "clear"
     }
    },
    "cloudy": {
     "kind": "set",
     "next": "reply",
     "set": {
      "sky": "cloudy"
     }
    },
    "fog": {
     "kind": "set",
     "next": "reply",
     "set": {
      "sky": "foggy"
     }
    },
    "forecast": {
     "extract": [
      {
       "into": "temp",
       "json": "json.current.temperature_2m"
      },
      {
       "into": "humidity",
       "json": "json.current.relative_humidity_2m"
      },
      {
       "into": "wind",
       "json": "json.current.wind_speed_10m"
      },
      {
       "into": "code",
       "json": "json.current.weather_code"
      },
      {
       "into": "unit",
       "json": "json.current_units.temperature_2m"
      }
     ],
     "http": {
      "method": "GET",
      "url": "https://api.open-meteo.com/v1/forecast?latitude={{ state.lat }}&longitude={{ state.lon }}&current=temperature_2m,relative_humidity_2m,wind_speed_10m,weather_code&temperature_unit={{ inputs.units }}"
     },
     "into": "fc",
     "kind": "observe",
     "next": "have-temp"
    },
    "found": {
     "branches": [
      {
       "then": "forecast",
       "when": {
        "exists": true
       }
      },
      {
       "else": "unknown-place"
      }
     ],
     "kind": "decide",
     "on": "hit"
    },
    "geocode": {
     "extract": [
      {
       "into": "hit",
       "json": "json.results[0]"
      },
      {
       "into": "lat",
       "json": "json.results[0].latitude"
      },
      {
       "into": "lon",
       "json": "json.results[0].longitude"
      },
      {
       "into": "name",
       "json": "json.results[0].name"
      },
      {
       "into": "country",
       "json": "json.results[0].country"
      }
     ],
     "http": {
      "method": "GET",
      "url": "https://geocoding-api.open-meteo.com/v1/search?name={{ inputs.place | url }}&count=1&language=en&format=json"
     },
     "into": "geo",
     "kind": "observe",
     "next": "found"
    },
    "have-temp": {
     "branches": [
      {
       "then": "sky",
       "when": {
        "type": "number"
       }
      },
      {
       "else": "no-forecast"
      }
     ],
     "kind": "decide",
     "on": "temp"
    },
    "no-forecast": {
     "kind": "fail",
     "reason": "no-forecast",
     "say": "Open-Meteo found {{ state.name }} but returned no current temperature (status {{ state.fc.status }})."
    },
    "rain": {
     "kind": "set",
     "next": "reply",
     "set": {
      "sky": "raining"
     }
    },
    "reply": {
     "kind": "done",
     "output": {
      "country": "{{ state.country }}",
      "humidity": "{{ state.humidity }}",
      "place": "{{ state.name }}",
      "sky": "{{ state.sky }}",
      "temperature": "{{ state.temp }}",
      "unit": "{{ state.unit }}",
      "wind_kmh": "{{ state.wind }}"
     },
     "say": "{{ state.name }}, {{ state.country }}: {{ state.temp }}{{ state.unit }}, {{ state.sky }}, humidity {{ state.humidity }}%, wind {{ state.wind }} km/h."
    },
    "sky": {
     "branches": [
      {
       "then": "clear",
       "when": {
        "eq": 0
       }
      },
      {
       "then": "cloudy",
       "when": {
        "between": [
         1,
         3
        ]
       }
      },
      {
       "then": "fog",
       "when": {
        "between": [
         45,
         48
        ]
       }
      },
      {
       "then": "rain",
       "when": {
        "between": [
         51,
         67
        ]
       }
      },
      {
       "then": "snow",
       "when": {
        "between": [
         71,
         77
        ]
       }
      },
      {
       "then": "rain",
       "when": {
        "between": [
         80,
         82
        ]
       }
      },
      {
       "then": "snow",
       "when": {
        "between": [
         85,
         86
        ]
       }
      },
      {
       "then": "storm",
       "when": {
        "between": [
         95,
         99
        ]
       }
      },
      {
       "else": "unknown-sky"
      }
     ],
     "kind": "decide",
     "on": "code"
    },
    "snow": {
     "kind": "set",
     "next": "reply",
     "set": {
      "sky": "snowing"
     }
    },
    "storm": {
     "kind": "set",
     "next": "reply",
     "set": {
      "sky": "stormy"
     }
    },
    "unknown-place": {
     "kind": "fail",
     "reason": "unknown-place",
     "say": "I could not find a place called {{ inputs.place }}."
    },
    "unknown-sky": {
     "kind": "set",
     "next": "reply",
     "set": {
      "sky": "weather code {{ state.code }}"
     }
    }
   },
   "start": "geocode",
   "tags": [
    "weather",
    "read-only"
   ],
   "triggers": [
    {
     "pattern": "[what's the] weather in {place}"
    },
    {
     "pattern": "[what's the] weather for {place}"
    },
    {
     "pattern": "how [hot|cold|warm] is it in {place}"
    }
   ],
   "version": 1
  }
 }
}
